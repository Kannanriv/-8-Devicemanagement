# syntax=docker/dockerfile:1.7-labs
# #8 Device Management — operations console (Next.js 15).
# Build from the repo root:
#   docker build -f infra/Dockerfile.console \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com/api/v1 -t hash8/console .
# NEXT_PUBLIC_* values are inlined at build time.

ARG NODE_VERSION=22.20.0

FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
ENV CI=1 NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY --parents packages/*/package.json apps/*/package.json tools/*/package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund --ignore-scripts

FROM deps AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_WS_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
COPY tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps/console ./apps/console
# next.config.ts is loaded at runtime (needs typescript), so dev deps are kept.
RUN npm run build -w @hash8/console \
    && mkdir -p apps/console/public

# Runtime: non-root. (Setting `output: "standalone"` in
# next.config.ts would shrink this further — owned by the console team.)
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3100 HOSTNAME=0.0.0.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/apps/console/package.json /app/apps/console/next.config.ts ./apps/console/
COPY --from=build --chown=node:node /app/apps/console/.next ./apps/console/.next
COPY --from=build --chown=node:node /app/apps/console/public ./apps/console/public
USER node
WORKDIR /app/apps/console
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 \
  CMD node -e "fetch('http://127.0.0.1:3100/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "../../node_modules/next/dist/bin/next", "start", "-p", "3100"]
