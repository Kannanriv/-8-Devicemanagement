{
  "dcs": "1.0",
  "id": "voltix.energy-em3",
  "version": "1.4.0",
  "device": {
    "vendor": "Voltix",
    "model": "EM3",
    "description": "Voltix EM3 DIN-rail three-phase energy meter with latching relay, MQTT over Ethernet/LTE-M.",
    "firmware": ">=1.2.0",
    "protocols": [
      "mqtt"
    ],
    "category": "energy-meter"
  },
  "defaults": {
    "endian": "little"
  },
  "uplink": [
    {
      "name": "realtime",
      "description": "Instantaneous per-phase measurements, published every 60 s.",
      "when": {
        "port": 1,
        "topic": "voltix/em3/+/realtime"
      },
      "source": {
        "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
        "sheet": "Realtime",
        "cell": "A2",
        "row": 2
      },
      "fields": [
        {
          "name": "meterId",
          "type": "bytes",
          "length": 4,
          "description": "Meter serial (4 bytes, hex)",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "C4",
            "row": 4
          }
        },
        {
          "kind": "repeat",
          "name": "phases",
          "count": 3,
          "description": "L1, L2, L3",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "A6",
            "row": 6
          },
          "fields": [
            {
              "name": "voltage",
              "type": "uint",
              "bits": 16,
              "scale": 0.1,
              "unit": "V",
              "min": 0,
              "max": 300,
              "description": "RMS phase-neutral voltage",
              "semantic": "lwm2m:3316/5700",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Realtime",
                "cell": "C7",
                "row": 7
              }
            },
            {
              "name": "current",
              "type": "uint",
              "bits": 16,
              "scale": 0.01,
              "unit": "A",
              "max": 100,
              "description": "RMS current",
              "semantic": "lwm2m:3317/5700",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Realtime",
                "cell": "C8",
                "row": 8
              }
            },
            {
              "name": "power",
              "type": "int",
              "bits": 32,
              "unit": "W",
              "description": "Active power (negative = export)",
              "semantic": "lwm2m:3328/5700",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Realtime",
                "cell": "C9",
                "row": 9
              }
            },
            {
              "name": "pf",
              "type": "int",
              "bits": 8,
              "scale": 0.01,
              "min": -1,
              "max": 1,
              "description": "Power factor",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Realtime",
                "cell": "C10",
                "row": 10
              }
            }
          ]
        },
        {
          "name": "totalEnergy",
          "type": "uint",
          "bits": 32,
          "scale": 0.01,
          "unit": "kW.h",
          "description": "Total imported active energy",
          "semantic": "lwm2m:3331/5805",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "C12",
            "row": 12
          }
        },
        {
          "name": "frequency",
          "type": "uint",
          "bits": 16,
          "scale": 0.01,
          "unit": "Hz",
          "min": 45,
          "max": 65,
          "description": "Grid frequency",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "C13",
            "row": 13
          }
        },
        {
          "name": "alarm",
          "type": "uint",
          "bits": 8,
          "description": "Active alarm",
          "enum": {
            "0": "none",
            "1": "overvoltage",
            "2": "undervoltage",
            "3": "overcurrent",
            "4": "phase_loss",
            "5": "tamper"
          },
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "C14",
            "row": 14
          }
        },
        {
          "kind": "checksum",
          "name": "crc",
          "algo": "crc16-modbus",
          "description": "CRC-16/MODBUS, low byte first",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Realtime",
            "cell": "C15",
            "row": 15
          }
        }
      ]
    },
    {
      "name": "daily_summary",
      "description": "Daily energy summary with per-interval readings, published at 00:05 local time.",
      "when": {
        "port": 2,
        "topic": "voltix/em3/+/daily"
      },
      "source": {
        "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
        "sheet": "Daily",
        "cell": "A2",
        "row": 2
      },
      "fields": [
        {
          "name": "meterId",
          "type": "bytes",
          "length": 4,
          "description": "Meter serial (4 bytes, hex)",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "C4",
            "row": 4
          }
        },
        {
          "kind": "group",
          "name": "date",
          "description": "Summary date",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "A5",
            "row": 5
          },
          "fields": [
            {
              "name": "year",
              "type": "uint",
              "bits": 16,
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Daily",
                "cell": "C5",
                "row": 5
              }
            },
            {
              "name": "month",
              "type": "uint",
              "bits": 8,
              "min": 1,
              "max": 12,
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Daily",
                "cell": "C6",
                "row": 6
              }
            },
            {
              "name": "day",
              "type": "uint",
              "bits": 8,
              "min": 1,
              "max": 31,
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Daily",
                "cell": "C7",
                "row": 7
              }
            }
          ]
        },
        {
          "name": "dailyEnergy",
          "type": "uint",
          "bits": 32,
          "scale": 0.01,
          "unit": "kW.h",
          "description": "Energy imported during the day",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "C8",
            "row": 8
          }
        },
        {
          "name": "peakDemand",
          "type": "uint",
          "bits": 32,
          "unit": "W",
          "description": "Peak 15-min demand",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "C9",
            "row": 9
          }
        },
        {
          "name": "count",
          "type": "uint",
          "bits": 8,
          "max": 24,
          "description": "Number of interval readings that follow",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "C10",
            "row": 10
          }
        },
        {
          "kind": "repeat",
          "name": "intervals",
          "count": {
            "ref": "count"
          },
          "description": "Interval readings",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "A11",
            "row": 11
          },
          "fields": [
            {
              "name": "hour",
              "type": "uint",
              "bits": 8,
              "max": 23,
              "unit": "h",
              "description": "Interval start hour",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Daily",
                "cell": "C12",
                "row": 12
              }
            },
            {
              "name": "energy",
              "type": "uint",
              "bits": 16,
              "scale": 0.01,
              "unit": "kW.h",
              "description": "Energy in interval",
              "source": {
                "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
                "sheet": "Daily",
                "cell": "C13",
                "row": 13
              }
            }
          ]
        },
        {
          "kind": "checksum",
          "name": "crc",
          "algo": "crc16-modbus",
          "description": "CRC-16/MODBUS, low byte first",
          "source": {
            "file": "Voltix_EM3_MQTT_Register_Map_r5.xlsx",
            "sheet": "Daily",
            "cell": "C14",
            "row": 14
          }
        }
      ]
    }
  ],
