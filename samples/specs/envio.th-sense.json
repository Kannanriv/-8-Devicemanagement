      "port": 1,
      "message": "periodic",
      "hex": "0000000ba440",
      "data": {
        "temperature": 0,
        "humidity": 0,
        "battery": 2980,
        "status": {
          "low_battery": false,
          "sensor_error": true
        }
      }
    },
    {
      "name": "config ack – interval ok",
      "port": 2,
